#!/bin/sh
# Asuswrt-Merlin runs this on WAN events, without waiting for it. A WAN coming
# up restarts the firewall too, and both hooks apply: --wait queues this apply
# behind a running one rather than exiting at once, so neither is lost.

PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
VPD_SCRIPT="${VPD_SCRIPT:-/opt/vpn-director/vpn-director.sh}"

[ "$2" = "connected" ] || exit 0

if [ -x "$VPD_SCRIPT" ]; then
    "$VPD_SCRIPT" --wait apply
else
    logger -t "wan-event" "vpn-director not found at $VPD_SCRIPT"
fi
