#!/bin/sh
# Asuswrt-Merlin runs /jffs/scripts/firewall-start after every firewall start,
# without waiting for it. That file is shared with the owner and other add-ons:
# VPN Director puts one line into it (vpn-director.sh hooks), which calls this
# script with the same arguments.
#
# The firewall start empties every mangle chain and deletes none - TUN_DIR and
# XRAY_TPROXY included - so the apply after the last one has to run. A plain
# apply exits at once while another instance holds the lock, and one still
# running from an earlier start (or wan-event, or the watch) then left the
# chains empty until the next event; --wait queues behind it instead.
#
# The chains are refilled first, from the snapshot of the last apply
# (fwsnap-restore.sh): one iptables-restore, where the apply takes seconds.
# The apply is detached, its descriptors closed, so the commands after our line
# in the shared file run at once instead of waiting for it; it waits for them.

PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
VPD_SCRIPT="${VPD_SCRIPT:-/opt/vpn-director/vpn-director.sh}"
VPD_RESTORE="${VPD_RESTORE:-/opt/vpn-director/lib/fwsnap-restore.sh}"

if [ -x "$VPD_SCRIPT" ]; then
    if [ -x "$VPD_RESTORE" ]; then
        "$VPD_RESTORE" mangle >/dev/null 2>&1
    fi
    # The apply waits for the shell running the shared hook - VPD_HOOK_SHELL,
    # which our line there passes - to finish the commands after our line, a
    # minute at most: iptables 1.4.15 on Merlin takes no lock, and two writers
    # of one table at once can lose a rule of either. Run any other way, the
    # hook applies at once.
    (
        n=0
        while [ -n "${VPD_HOOK_SHELL:-}" ] && [ "$n" -lt 60 ] && kill -0 "$VPD_HOOK_SHELL" 2>/dev/null; do
            sleep 1
            n=$((n + 1))
        done
        exec "$VPD_SCRIPT" --wait apply
    ) </dev/null >/dev/null 2>&1 &
else
    logger -t "firewall-start" "vpn-director not found at $VPD_SCRIPT"
fi
