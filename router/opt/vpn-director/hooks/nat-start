#!/bin/sh
# Asuswrt-Merlin runs /jffs/scripts/nat-start after it rebuilt the nat table - a
# WAN coming up, a port forward changed - without waiting for it. That file is
# shared with the owner and other add-ons: VPN Director puts one line into it
# (vpn-director.sh hooks), which calls this script. The rebuild replaces the
# whole table, so the MASQUERADE of every interface tunnel
# (tunnel_director.interfaces) is gone until an apply puts it back. A plain
# apply exits at once while another instance holds the lock; --wait queues it
# behind the running one instead.
#
# The MASQUERADE goes back first, from the snapshot of the last apply
# (fwsnap-restore.sh), where the apply takes seconds. The apply is detached,
# its descriptors closed, so the commands after our line in the shared file run
# at once.

PATH=/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin
VPD_SCRIPT="${VPD_SCRIPT:-/opt/vpn-director/vpn-director.sh}"
VPD_RESTORE="${VPD_RESTORE:-/opt/vpn-director/lib/fwsnap-restore.sh}"

if [ -x "$VPD_SCRIPT" ]; then
    if [ -x "$VPD_RESTORE" ]; then
        "$VPD_RESTORE" nat >/dev/null 2>&1
    fi
    "$VPD_SCRIPT" --wait apply </dev/null >/dev/null 2>&1 &
else
    logger -t "nat-start" "vpn-director not found at $VPD_SCRIPT"
fi
