                  "encryption": "none"
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "WS",
          "security": "TLS",
          "wsSettings": {
            "path": "/ws"
          },
          "tlsSettings": {
            "serverName": "vc1.example.com"
          }
        }
      }
    ]
  },
  {
